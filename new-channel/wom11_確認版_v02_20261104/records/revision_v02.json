    "english_sentences": [
      {
        "id": "P10-05",
        "text": "Thoth writes down the result.",
        "spoken_text": "Thoth writes down the result.",
        "start": 274.00191666666666,
        "end": 276.09454166666666,
        "audio_file": "audio/en/sentences/P10-05.wav",
        "audio_sha256": "55bec4a98977c26bda212dca9d38da7ebc9d17e75fe7756192ce1b53f6b83130",
        "replacements": [],
        "role": "plain"
      },
      {
        "id": "P10-06",
        "text": "And nearby waits Ammit, the Devourer.",
        "spoken_text": "And nearby waits Ammit, the Devourer.",
        "start": 276.39454166666667,
        "end": 279.22249999999997,
        "audio_file": "audio/en/sentences/P10-06.wav",
        "audio_sha256": "8ae8812fe0f923d55aa5154e5e282ff9bb372b43086b5681d7f78d8ec5efa1fa",
        "replacements": [],
        "role": "plain"
      },
      {
        "id": "P10-07",
        "text": "One old description calls her part crocodile, part lion, and part hippopotamus.",
        "spoken_text": "One old description calls her part crocodile, part lion, and part hippopotamus.",
        "start": 279.5225,
        "end": 285.65179166666667,
        "audio_file": "audio/en/sentences/P10-07.wav",
        "audio_sha256": "ced04299e2793815fa1a6faad034f2f0d0d6de02f686ee226280721d3f5371ba",
        "replacements": [],
        "role": "plain"
      }
    ],
    "japanese_sentences": [
      {
        "id": "P10-05",
        "text": "トトが結果を書き記します。",
        "spoken_text": "トトが結果を書き記します。",
        "start": 276.096,
        "end": 277.9626666666667,
        "audio_file": "audio/ja/sentences/P10-05.wav",
        "audio_sha256": "ffd7ab97fe60c417d3bdb89104f0e81f33b3bc98bea7ab5397e12c3f7f7df8b8",
        "replacements": [],
        "role": "plain"
      },
      {
        "id": "P10-06",
        "text": "そしてそばには、むさぼり食う者、アメミトが待っています。",
        "spoken_text": "そしてそばには、むさぼり食う者、アメミトが待っています。",
        "start": 278.28266666666667,
        "end": 282.272,
        "audio_file": "audio/ja/sentences/P10-06.wav",
        "audio_sha256": "d1d65c4fa018c3f98405fe1fa501e9c916d3931bd93292e0b51529f5db2a637a",
        "replacements": [],
        "role": "plain"
      },
      {
        "id": "P10-07",
        "text": "古い記述では、ワニとライオンとカバが合わさった姿とされます。",
        "spoken_text": "古い記述では、ワニとライオンとカバが合わさった姿とされます。",
        "start": 282.592,
