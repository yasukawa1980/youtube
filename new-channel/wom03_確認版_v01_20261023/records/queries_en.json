[
  {
    "sentence_id": "M01-01",
    "role": "opening",
    "config": {
      "text": "Snakes for hair.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M01-02",
    "role": "plain",
    "config": {
      "text": "A gaze that turns people to stone.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M01-03",
    "role": "plain",
    "config": {
      "text": "Medusa is one of the most famous monsters of Greek myth.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M01-04",
    "role": "plain",
    "config": {
      "text": "Today, she is also seen as a victim, a woman punished for something that was done to her.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M01-05",
    "role": "question",
    "config": {
      "text": "So which is she?",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M01-06",
    "role": "plain",
    "config": {
      "text": "The answer depends on which source you read.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M02-01",
    "role": "plain",
    "config": {
      "text": "In this episode, we follow Medusa across seven centuries of Greek and Roman poetry and art: an early poem about the gods, faces on ancient shields and temples, a painted vase at The Metropolitan Museum of Art, and a Roman poet who told her story in a new way.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M03-01",
    "role": "plain",
    "config": {
      "text": "One of the earliest accounts comes from the Greek poet Hesiod, around 700 BCE.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "wˈʌn ʌvðɪ ˈɜːlɪɪst ɐkˈaʊnts kˈʌmz fɹʌmðə ɡɹˈiːk pˈoʊɪt hˈiːsiəd , ɚɹˈaʊnd sˈɛvənhˈʌndɹɪd bˌiːsˌiːˈiː."
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M03-02",
    "role": "plain",
    "config": {
      "text": "In his Theogony, a poem about the origins of the gods, Medusa is one of three Gorgon sisters, daughters of ancient sea deities.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "ɪn hˈɪz θiˈɑːɡəni , ɐ pˈoʊᵻm ɐbˌaʊt ðɪ ˈɔːɹɪdʒˌɪnz ʌvðə ɡˈɑːdz, mədˈuːsə ɪz wˈʌn ʌv θɹˈiː ɡˈɔːɹɡən sˈɪstɚz, dˈɔːɾɚz ʌv ˈeɪntʃənt sˈiː dˈiːətiz."
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M03-03",
    "role": "plain",
    "config": {
      "text": "Her sisters, Stheno and Euryale, are immortal.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "hɜː sˈɪstɚz, sθˈiːnoʊ ænd jʊɹˈaɪəli , ɑːɹ ɪmˈɔːɹɾəl."
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M03-04",
    "role": "plain",
    "config": {
      "text": "Medusa alone is mortal.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M04-01",
    "role": "plain",
    "config": {
      "text": "Hesiod tells us very little about her.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "hˈiːsiəd tˈɛlz ˌʌs vˈɛɹi lˈɪɾəl ɐbˈaʊt hɜː."
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M04-02",
    "role": "plain",
    "config": {
      "text": "He says that Poseidon lay with her in a soft meadow among spring flowers, and that when Perseus cut off her head, the winged horse Pegasus and Chrysaor, named for his golden sword, sprang from her.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "hiː sˈɛz ðæt pəsˈaɪdən lˈeɪ wɪð hɜːɹ ɪn ɐ sˈɔft mˈɛdoʊ ɐmˌʌŋ spɹˈɪŋ flˈaʊɚz, ænd ðæt wɛn pˈɜːsɪəs kˈʌt ˈɔf hɜː hˈɛd, ðə wˈɪŋd hˈɔːɹs pˈɛɡəsəs ænd kɹaɪˈseɪɔːɹ , nˈeɪmd fɔːɹ hɪz ɡˈoʊldən sˈɔːɹd, spɹˈæŋ fɹʌm hɜː."
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M04-03",
    "role": "plain",
    "config": {
      "text": "There is no curse and no punishment.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M04-04",
    "role": "plain",
    "config": {
      "text": "In Hesiod, Medusa is simply born a Gorgon.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "ˈɪn hˈiːsiəd , mədˈuːsə ɪz sˈɪmpli bˈɔːɹn ɐ ɡˈɔːɹɡən."
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M05-01",
    "role": "plain",
    "config": {
      "text": "Early Greek artists gave the Gorgon an unforgettable face.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M05-02",
    "role": "plain",
    "config": {
      "text": "In the sixth century BCE, she often looks like this: wide, staring eyes, a grinning mouth, sharp tusks, and a protruding tongue.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M05-03",
    "role": "plain",
    "config": {
      "text": "She is not meant to be beautiful.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M05-04",
    "role": "plain",
    "config": {
      "text": "She is meant to be seen.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M06-01",
    "role": "plain",
    "config": {
      "text": "Faces like this, called gorgoneia, appeared on shields, on drinking cups, and on the tiles along temple roofs.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "fˈeɪsᵻz lˈaɪk ðˈɪs, kˈɔːld ɡɔːɹɡəˈniːə , ɐpˈɪɹd ˌɔn ʃˈiːldz, ˌɔn dɹˈɪŋkɪŋ kˈʌps, ænd ɔnðə tˈaɪlz ɐlˈɔŋ tˈɛmpəl ɹˈuːfs."
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M06-02",
    "role": "plain",
    "config": {
      "text": "Many scholars think they were meant to frighten away harm.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M06-03",
    "role": "plain",
    "config": {
      "text": "The monster's face could also serve as a guardian.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M07-01",
    "role": "plain",
    "config": {
      "text": "Even the goddess Athena carried it.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M07-02",
    "role": "plain",
    "config": {
      "text": "As early as Homer's Iliad, the Gorgon's head appears on the aegis, Athena's protective goatskin.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M07-03",
    "role": "plain",
    "config": {
      "text": "The face of the defeated monster became part of the goddess's own power.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M08-01",
    "role": "plain",
    "config": {
      "text": "Over time, the image began to change.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M08-02",
    "role": "plain",
    "config": {
      "text": "Around 490 BCE, the poet Pindar spoke of fair-cheeked Medusa.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M08-03",
    "role": "plain",
    "config": {
      "text": "He also told how Athena invented a melody for the aulos, a reed pipe, to imitate the lament of the Gorgons for their sister.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "hiː ˈɔːlsoʊ tˈoʊld hˌaʊ æθˈiːnə ɪnvˈɛntᵻd ɐ mˈɛlədi fɚðə ˈaʊlɑːs , ɐ ɹˈiːd pˈaɪp, tʊ ˈɪmᵻtˌeɪt ðə lɐmˈɛnt ʌvðə ɡˈɔːɹɡənz fɔːɹ ðɛɹ sˈɪstɚ."
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M09-01",
    "role": "plain",
    "config": {
      "text": "On this vase at The Metropolitan Museum of Art, painted in Athens around 450 BCE, Perseus comes upon Medusa as she sleeps, with Athena close by.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M09-02",
    "role": "plain",
    "config": {
      "text": "Medusa still has wings, but her face is young and calm.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M09-03",
    "role": "plain",
    "config": {
      "text": "The museum describes it as one of the earliest images of Medusa with an attractive face.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M10-01",
    "role": "question",
    "config": {
      "text": "Why did artists begin to show her this way?",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M10-02",
    "role": "plain",
    "config": {
      "text": "Scholars have suggested several reasons, from changing ideals of beauty to new ways of telling the story.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M10-03",
    "role": "plain",
    "config": {
      "text": "The sources do not give a single answer.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M10-04",
    "role": "plain",
    "config": {
      "text": "But by the fifth century BCE, Medusa could be both terrifying and beautiful.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M11-01",
    "role": "plain",
    "config": {
      "text": "The version best known today comes later, from Rome.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M11-02",
    "role": "plain",
    "config": {
      "text": "Around the year eight C E, the poet Ovid completed his Metamorphoses, a long poem about transformations.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M11-03",
    "role": "plain",
    "config": {
      "text": "In Book Four, Perseus himself tells the story.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M11-04",
    "role": "plain",
    "config": {
      "text": "Medusa, he says, was once a beautiful young woman, admired above all for her hair.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M12-01",
    "role": "plain",
    "config": {
      "text": "Then, it is said, Neptune, the Roman name for Poseidon, assaulted her in the temple of Minerva, the Roman Athena.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M12-02",
    "role": "plain",
    "config": {
      "text": "The goddess hid her face behind her aegis.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M12-03",
    "role": "plain",
    "config": {
      "text": "And so that the act would not go unpunished, she changed Medusa's hair into snakes.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M13-01",
    "role": "plain",
    "config": {
      "text": "Ovid wrote about seven hundred years after Hesiod, and he often reshaped older myths in his own way.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "ˈoʊvɪd ɹˈoʊt ɐbˌaʊt sˈɛvən hˈʌndɹɪd jˈɪɹz ˈæftɚ hˈiːsiəd , ænd hiː ˈɔfən ɹᵻʃˈeɪpt ˈoʊldɚ mˈɪθs ɪn hɪz ˈoʊn wˈeɪ."
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M13-02",
    "role": "plain",
    "config": {
      "text": "Other ancient writers tell different stories.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M13-03",
    "role": "plain",
    "config": {
      "text": "The mythographer known as Apollodorus reports that, according to some, Medusa was beheaded for Athena's sake, because she wished to rival the goddess in beauty.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "ðə mɪθˈɑːɡɹəfɚ nˈoʊn æz əpɑːləˈdɔːɹəs ɹᵻpˈɔːɹts ðˈæt, ɐkˈɔːɹdɪŋ tə sˌʌm, mədˈuːsə wʌz bᵻhˈɛdᵻd fɔːɹ æθˈiːnəz sˈeɪk, bɪkˈʌz ʃiː wˈɪʃt tə ɹˈaɪvəl ðə ɡˈɑːdəs ɪn bjˈuːɾi."
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M14-01",
    "role": "plain",
    "config": {
      "text": "Medusa's story lived on long after the ancient world.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M14-02",
    "role": "plain",
    "config": {
      "text": "In the early 1800s, the sculptor Antonio Canova carved Perseus holding up her head in triumph.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M14-03",
    "role": "plain",
    "config": {
      "text": "For Medusa's face, Canova followed an ancient marble mask of a beautiful, sorrowful Medusa.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M14-04",
    "role": "plain",
    "config": {
      "text": "The hero is the center of this statue.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M15-01",
    "role": "plain",
    "config": {
      "text": "In the twentieth century, many writers and artists returned to Ovid's version and read Medusa as a woman who was wronged, and then blamed.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M15-02",
    "role": "plain",
    "config": {
      "text": "That reading is a modern interpretation.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M15-03",
    "role": "plain",
    "config": {
      "text": "But it is built on an ancient text.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0
  },
  {
    "sentence_id": "M16-01",
    "role": "question",
    "config": {
      "text": "So is Medusa a monster or a victim?",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12
    },
    "gap_after": 0.3
  },
  {
    "sentence_id": "M16-02",
    "role": "plain",
    "config": {
      "text": "In Hesiod, she is born a Gorgon.",
      "voice": "af_heart",
      "speed": 0.82,
      "sentence_pause": 0.3,
      "clause_pause": 0.12,
      "phonemes": "ˈɪn hˈiːsiəd , ʃiː ɪz bˈɔːɹn ɐ ɡˈɔːɹɡən."
    },
    "gap_after": 0.3
