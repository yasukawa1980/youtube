{
  "duration_seconds": 87.5,
  "voice": "VOICEVOX:冥鳴ひまり",
  "cues": [
    {
      "id": "N01-01",
      "text": "一つの心臓が、天秤に置かれる。",
      "start": 1.8,
      "end": 4.498666666666667
    },
    {
      "id": "N01-02",
      "text": "向かい側にあるのは、正しいあり方を表すもの。",
      "start": 4.898666666666666,
      "end": 8.450666666666667
    },
    {
      "id": "N01-03",
      "text": "秤のそばに立つのは、犬のような頭を持つ神、アヌビス。",
      "start": 8.770666666666667,
      "end": 13.154666666666667
    },
    {
      "id": "N01-04",
      "text": "死者を裁く恐ろしい神として、よく知られた姿です。",
      "start": 13.474666666666666,
      "end": 17.282666666666668
    },
    {
      "id": "N01-05",
      "text": "けれど、残された資料をよく見ると、アヌビスは一人で裁いているわけではありません。",
      "start": 17.602666666666668,
      "end": 23.512
    },
    {
      "id": "N02-01",
      "text": "では、アヌビスは何をしている神なのでしょう。",
      "start": 24.412,
      "end": 27.526666666666667
    },
    {
      "id": "N02-02",
      "text": "墓を見張り、亡くなった人の身体を守り、死者の旅を支える。",
      "start": 27.926666666666666,
      "end": 32.67333333333333
    },
    {
      "id": "N02-03",
      "text": "そして、心臓を量る秤を確かめる。",
      "start": 32.99333333333333,
      "end": 35.884
    },
    {
      "id": "N02-04",
      "text": "今回は、メトロポリタン美術館に残る彫像やパピルスを手がかりに、資料の中のアヌビスの仕事を、一つずつ見ていきます。",
      "start": 36.204,
      "end": 45.14266666666666
    },
    {
      "id": "N03-01",
      "text": "画面には、博物館に残る資料の写真と、理解を助けるための再現イメージが登場します。",
      "start": 46.04266666666667,
      "end": 52.88
    },
    {
      "id": "N03-02",
      "text": "再現イメージには、画面の右上に表示を付けています。",
      "start": 53.2,
      "end": 57.18933333333333
    },
    {
      "id": "N03-03",
      "text": "それでは、一つめの資料から見ていきましょう。",
      "start": 57.50933333333333,
      "end": 60.64533333333333
    },
    {
      "id": "N04-01",
      "text": "まず、横たわる犬科の動物の像を見てください。",
      "start": 61.54533333333333,
      "end": 65.00133333333333
    },
    {
      "id": "N04-02",
      "text": "前足を伸ばし、耳を立てた姿は、眠っているというより、周囲を見張っているようです。",
      "start": 65.32133333333333,
      "end": 71.67866666666667
    },
    {
      "id": "N04-03",
      "text": "メトロポリタン美術館にあるこの像は石灰岩で作られ、もとは黒く塗られていました。",
      "start": 72.07866666666666,
      "end": 77.93466666666667
    },
    {
      "id": "N04-04",
      "text": "神は、人の姿だけで表されたわけではなかったのです。",
      "start": 78.25466666666667,
      "end": 82.41466666666666
    }
  ]
}
