  "caption_texts": {
    "S1": [
      "The Sphinx's riddle is",
      "never quoted in",
      "Sophocles' Oedipus the King.",
      "Later writers give it:",
      "what has one voice,",
      "and becomes four-footed,",
      "two-footed, and three-footed?",
      "A human being.",
      "In these texts, there is",
      "no morning, noon, or evening."
    ],
    "S3": [
      "The Sphinx's nose was",
      "already gone before Napoleon.",
      "Drawings by the Danish traveler",
      "Frederic Norden, who visited",
      "in the 1730s,",
      "already show the face",
      "without its nose.",
      "They were printed long before",
      "Napoleon came to Egypt",
      "in 1798."
    ]
  },
