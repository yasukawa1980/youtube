      "caption_list": [
        {
          "text": "The Trojan horse is not in the Iliad.",
          "start": 0.0,
          "end": 3.2333333333333334
        },
        {
          "text": "Homer's Iliad ends before the horse is even built.",
          "start": 3.2333333333333334,
          "end": 7.2
        },
        {
          "text": "In one old translation, its last line reads:",
          "start": 7.2,
          "end": 11.1
        },
        {
          "text": "\"Thus held they funeral for Hector tamer of horses.\"",
          "start": 11.1,
          "end": 14.9
        },
        {
          "text": "The wooden horse appears later, in the Odyssey.",
          "start": 14.9,
          "end": 18.066666666666666
        }
      ]
    },
    {
      "id": "T2",
      "v01_audio_stream_hash": "SHA256=81aaafb6f48e705fa22a5b4ceffe0c6a34a864e3ba801fc54ebdf18456f57db2",
