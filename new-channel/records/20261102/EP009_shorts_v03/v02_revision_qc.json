      "three_word_line_exceptions": [
        {
          "text": "This famous warning",
          "words": 3
        },
        {
          "text": "written about two",
          "words": 3
        },
        {
          "text": "thousand years ago.",
          "words": 3
        }
      ],
      "caption_list": [
        {
          "text": "\"I fear the Grecians even when they offer gifts.\"",
          "start": 0.0,
          "end": 3.8
        },
        {
          "text": "This famous warning is not from Homer.",
          "start": 3.8,
          "end": 6.9
        },
        {
          "text": "It comes from Virgil's Aeneid,",
          "start": 6.9,
          "end": 9.0
        },
        {
          "text": "written about two thousand years ago.",
          "start": 9.0,
          "end": 12.0
        },
        {
          "text": "There, the Trojan priest Laocoön says it, and",
          "start": 12.0,
          "end": 15.566666666666666
        },
        {
          "text": "then hurls his spear at the wooden horse.",
          "start": 15.566666666666666,
          "end": 18.333333333333332
        }
      ]
    }
