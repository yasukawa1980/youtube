      "three_word_line_exceptions": [],
      "caption_list": [
        {
          "text": "This is one of the oldest known pictures",
          "start": 0.0,
          "end": 2.466666666666667
        },
        {
          "text": "of the Trojan horse.",
          "start": 2.466666666666667,
          "end": 4.333333333333333
        },
        {
          "text": "It is on a clay jar from the",
          "start": 4.333333333333333,
          "end": 6.1
        },
        {
          "text": "Greek island of Mykonos,",
          "start": 6.1,
          "end": 8.3
        },
        {
          "text": "made around 670 BC.",
          "start": 8.3,
          "end": 11.533333333333333
        },
        {
          "text": "The horse stands on wheels.",
          "start": 11.533333333333333,
          "end": 13.666666666666666
        },
        {
          "text": "And in its side,",
          "start": 13.666666666666666,
          "end": 15.066666666666666
        },
        {
          "text": "small windows show the faces",
          "start": 15.066666666666666,
          "end": 17.033333333333335
        },
        {
          "text": "of warriors hidden inside.",
          "start": 17.033333333333335,
          "end": 19.1
        }
      ]
    },
    {
      "id": "T3",
      "v01_audio_stream_hash": "SHA256=651c64d2a9a4df377ea7f213df1948a17af96d17bf04e2d63a2b6822ae9c4edd",
      "v02_audio_stream_hash": "SHA256=651c64d2a9a4df377ea7f213df1948a17af96d17bf04e2d63a2b6822ae9c4edd",
