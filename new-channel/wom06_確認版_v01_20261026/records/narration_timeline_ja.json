          "audio_sha256": "45b91c026dab98b5d6cf0dae8391f74a478934774b2c3f6d07acf9d4dafcc023",
          "replacements": [],
          "role": "plain"
        },
        {
          "id": "P02-05",
          "text": "一つの名前が両方を指すようになったわけを見ていきます。",
          "spoken_text": "一つの名前が両方を指すようになったわけを見ていきます。",
          "start": 35.218,
          "end": 38.88733333333333,
          "audio_file": "audio/ja/sentences/P02-05.wav",
          "audio_sha256": "b3f43dc1537c31f62fd827c3593982db978c395823262594b9721523a72f6153",
          "replacements": [],
          "role": "plain"
