          "audio_sha256": "ae152453dbdc02308e293d19d2bc54d1aa63d3bf163712828ca1efc827cdb919",
          "replacements": [],
          "role": "plain"
        },
        {
          "id": "P01-06",
          "text": "ギリシャの伝説のスフィンクスです。",
          "spoken_text": "ギリシャの伝説のスフィンクスです。",
          "start": 14.402000000000001,
          "end": 16.503333333333334,
          "audio_file": "audio/ja/sentences/P01-06.wav",
          "audio_sha256": "89f97b8197e70248a90d6a370966035fa9ea58568d26ade92be2c7fd88f1b3f0",
          "replacements": [],
          "role": "plain"
        },
        {
          "id": "P01-07",
          "text": "けれど、世界でいちばん有名なスフィンクス、エジプトの大きなスフィンクスは、だれにもなぞなぞを出したことがありません。",
          "spoken_text": "けれど、世界でいちばん有名なスフィンクス、エジプトの大きなスフィンクスは、だれにもなぞなぞを出したことがありません。",
          "start": 16.823333333333334,
          "end": 24.567333333333334,
          "audio_file": "audio/ja/sentences/P01-07.wav",
          "audio_sha256": "b45869d83b8a3c25cfbe67beb58e3db52889da86a7a70869918bbe0993ca657f",
          "replacements": [],
          "role": "contrast"
