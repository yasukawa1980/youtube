          "end": 26.42866666666667,
          "audio_file": "audio/ja/sentences/P01-08.wav",
          "audio_sha256": "ae7cc450f0c8b918cff2aa2cb6241d92239c267af9c8e01fec9232a222bf677a",
          "replacements": [],
          "role": "plain"
