          "audio_sha256": "e478a38cf468179dec8c71d88de60ce12b0298ab25aad09168b2c8b734aaa3e6",
          "replacements": [],
          "role": "transition"
        },
        {
          "id": "P02-02",
          "text": "エジプトの守り手と、",
          "spoken_text": "エジプトのまもりてと、",
