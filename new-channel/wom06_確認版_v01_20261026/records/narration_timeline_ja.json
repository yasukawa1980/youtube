          "replacements": [],
          "role": "plain"
        },
        {
          "id": "P03-04",
          "text": "体は、身を休めるライオンです。",
          "spoken_text": "体は、身を休めるライオンです。",
          "start": 59.22266666666666,
          "end": 61.62266666666666,
          "audio_file": "audio/ja/sentences/P03-04.wav",
